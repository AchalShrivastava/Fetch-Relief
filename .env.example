# ReliefMesh Configuration
# Environment: local, staging, production
ENVIRONMENT=local
DEBUG=True

# Backend Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Fetch.ai uAgent Configuration
AGENT_NAME=reliefmesh_coordinator
AGENT_PORT=8001
AGENT_SEED=reliefmesh_coordinator_hackathon_demo_seed_phrase_2026
AGENT_ENDPOINT=http://127.0.0.1:8001/submit

# Agentverse / Mailbox Integration (Optional - Set when registering on Agentverse)
# Leave MAILBOX_KEY blank for local multi-agent or direct HTTP simulation
AGENT_MAILBOX_KEY=
AGENTVERSE_API_KEY=

# ASI:One / ASI1 LLM Configuration (Optional - Fallback parser runs automatically if empty)
# Get key from https://asi1.ai/dashboard/api-keys
ASI_ONE_API_KEY=
ASI1_MODEL=asi1-mini
ASI1_BASE_URL=https://api.asi1.ai/v1

# Storage Configuration
# Uses sqlite/json local fallback if REDIS_URL is not provided
STORAGE_BACKEND=json
REDIS_URL=
LOCAL_DB_PATH=data/local_store.json
